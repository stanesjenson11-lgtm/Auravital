# ------------------------------------------------------------------
# AuraVitals .gitignore
# Keeps the repo small (no build output / caches) and free of secrets.
# ------------------------------------------------------------------

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IDE / editors
*.iml
*.ipr
*.iws
.idea/
.vscode/
*.code-workspace

# Flutter / Dart / Pub
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/

# Symbolication / obfuscation output
app.*.symbols
app.*.map.json

# Test coverage
coverage/
lcov.info

# Android build & machine-specific files
android/.gradle/
android/.kotlin/
android/captures/
android/local.properties
android/**/GeneratedPluginRegistrant.java
android/app/.cxx/
**/android/.gradle/
*.apk
*.aab
*.aar

# ------------------------------------------------------------------
# Secrets / signing / credentials  (never commit these)
# ------------------------------------------------------------------
android/key.properties
**/keystore.properties
*.jks
*.keystore
*.pem
*.p12
*.p8
*.cer
.env
.env.*
*.env
**/google-services.json
**/GoogleService-Info.plist
**/secrets.dart
**/*.secret

# OS files
Thumbs.db
ehthumbs.db

# Claude Code local (machine-specific) settings
.claude/settings.local.json
